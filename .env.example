# Hyperliquid API Configuration
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws

# Private key for signing transactions (without 0x prefix)
# Generate: openssl rand -hex 32
PRIVATE_KEY=your_private_key_here

# Strategy Configuration
BPS_THRESHOLD=20.0
POSITION_SIZE_USD=150.0
LEVERAGE=2
TIMEOUT_SECONDS=30

# Risk Management
MAX_LOSS_BPS=50.0
DAILY_LOSS_LIMIT_USD=20.0
EMERGENCY_STOP=false

# Trading Pair
PERP_SYMBOL=HYPE
SPOT_SYMBOL=HYPE

# Testing Mode (DRY RUN - Paper Trading)
DRY_RUN=true                    # true = simulate orders (paper trading), false = real trading
DRY_RUN_FILL_DELAY_MS=50        # Simulated order fill latency (realistic)
DRY_RUN_FILL_SUCCESS_RATE=95    # % of simulated orders that fill

# Logging
RUST_LOG=info
